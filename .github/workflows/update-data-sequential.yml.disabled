name: Update NAM CONUS Data (Sequential Chunks)

on:
  # Run every 6 hours (aligned with NAM update cycles: 00, 06, 12, 18 UTC)
  # Adding 3.5 hour offset to ensure data is available
  schedule:
    - cron: "30 3,9,15,21 * * *"  # 03:30, 09:30, 15:30, 21:30 UTC

  # Allow manual trigger
  workflow_dispatch:

  # Run on push to main and claude branches (for testing)
  push:
    branches:
      - main
      - claude/**

permissions:
  contents: write

jobs:
  # Process forecast hours 0-10 (11 hours) - FIRST JOB
  process-chunk-1:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          version: "latest"

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libeccodes-dev libgeos-dev

      - name: Install Python dependencies
        run: |
          uv pip install --system -e .

      - name: Process chunk 1 (hours 0-10)
        run: |
          python scripts/process_chunk.py 0 10 1
        env:
          PYTHONUNBUFFERED: 1

      - name: Upload chunk 1
        uses: actions/upload-artifact@v4
        with:
          name: chunk-1
          path: data/nam_conus_*_chunk1.zarr/
          retention-days: 1

  # Process forecast hours 11-20 (10 hours) - AFTER CHUNK 1
  process-chunk-2:
    runs-on: ubuntu-latest
    needs: process-chunk-1
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          version: "latest"

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libeccodes-dev libgeos-dev

      - name: Install Python dependencies
        run: |
          uv pip install --system -e .

      - name: Process chunk 2 (hours 11-20)
        run: |
          python scripts/process_chunk.py 11 20 2
        env:
          PYTHONUNBUFFERED: 1

      - name: Upload chunk 2
        uses: actions/upload-artifact@v4
        with:
          name: chunk-2
          path: data/nam_conus_*_chunk2.zarr/
          retention-days: 1

  # Process forecast hours 21-30 (10 hours) - AFTER CHUNK 2
  process-chunk-3:
    runs-on: ubuntu-latest
    needs: process-chunk-2
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          version: "latest"

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libeccodes-dev libgeos-dev

      - name: Install Python dependencies
        run: |
          uv pip install --system -e .

      - name: Process chunk 3 (hours 21-30)
        run: |
          python scripts/process_chunk.py 21 30 3
        env:
          PYTHONUNBUFFERED: 1

      - name: Upload chunk 3
        uses: actions/upload-artifact@v4
        with:
          name: chunk-3
          path: data/nam_conus_*_chunk3.zarr/
          retention-days: 1

  # Process forecast hours 31-40 (10 hours) - AFTER CHUNK 3
  process-chunk-4:
    runs-on: ubuntu-latest
    needs: process-chunk-3
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          version: "latest"

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libeccodes-dev libgeos-dev

      - name: Install Python dependencies
        run: |
          uv pip install --system -e .

      - name: Process chunk 4 (hours 31-40)
        run: |
          python scripts/process_chunk.py 31 40 4
        env:
          PYTHONUNBUFFERED: 1

      - name: Upload chunk 4
        uses: actions/upload-artifact@v4
        with:
          name: chunk-4
          path: data/nam_conus_*_chunk4.zarr/
          retention-days: 1

  # Process forecast hours 41-50 (10 hours) - AFTER CHUNK 4
  process-chunk-5:
    runs-on: ubuntu-latest
    needs: process-chunk-4
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          version: "latest"

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libeccodes-dev libgeos-dev

      - name: Install Python dependencies
        run: |
          uv pip install --system -e .

      - name: Process chunk 5 (hours 41-50)
        run: |
          python scripts/process_chunk.py 41 50 5
        env:
          PYTHONUNBUFFERED: 1

      - name: Upload chunk 5
        uses: actions/upload-artifact@v4
        with:
          name: chunk-5
          path: data/nam_conus_*_chunk5.zarr/
          retention-days: 1

  # Process forecast hours 51-60 (10 hours) - AFTER CHUNK 5
  process-chunk-6:
    runs-on: ubuntu-latest
    needs: process-chunk-5
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          version: "latest"

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libeccodes-dev libgeos-dev

      - name: Install Python dependencies
        run: |
          uv pip install --system -e .

      - name: Process chunk 6 (hours 51-60)
        run: |
          python scripts/process_chunk.py 51 60 6
        env:
          PYTHONUNBUFFERED: 1

      - name: Upload chunk 6
        uses: actions/upload-artifact@v4
        with:
          name: chunk-6
          path: data/nam_conus_*_chunk6.zarr/
          retention-days: 1

  # Merge all chunks into final dataset - AFTER ALL CHUNKS
  merge-and-publish:
    runs-on: ubuntu-latest
    needs: [process-chunk-1, process-chunk-2, process-chunk-3, process-chunk-4, process-chunk-5, process-chunk-6]
    timeout-minutes: 10

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          version: "latest"

      - name: Install Python dependencies
        run: |
          uv pip install --system xarray zarr

      - name: Download all chunks
        uses: actions/download-artifact@v4
        with:
          pattern: chunk-*
          path: data/

      - name: List downloaded chunks
        run: |
          echo "=== Downloaded chunks ==="
          ls -lh data/
          find data/ -name "*.zarr" -type d

      - name: Merge chunks
        run: |
          python scripts/merge_chunks.py
        env:
          PYTHONUNBUFFERED: 1

      - name: Clean up old datasets
        run: |
          echo "=== Cleaning up old datasets ==="
          # Keep only the 2 most recent datasets
          ls -t data/nam_conus_*.zarr 2>/dev/null | tail -n +3 | xargs -r rm -rf
          echo "=== Remaining datasets ==="
          ls -lh data/*.zarr 2>/dev/null || echo "No datasets found"

      - name: Generate data catalog
        run: |
          python scripts/generate_catalog.py
        continue-on-error: true

      - name: Commit and push catalog
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

          git add catalog/

          if git diff --staged --quiet; then
            echo "No catalog changes to commit"
          else
            git commit -m "Update data catalog"
            git push
          fi
        continue-on-error: true

      - name: Show final dataset info
        run: |
          echo "=== Generated Dataset ==="
          ls -lh data/*.zarr 2>/dev/null || echo "No final dataset found"
          echo ""
          echo "=== Catalog ==="
          cat catalog/catalog.json 2>/dev/null || echo "No catalog found"
